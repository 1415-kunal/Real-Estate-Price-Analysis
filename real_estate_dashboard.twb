    <worksheet name='Houses by Price Range'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Semibold'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='kc_house_data' name='federated.0eprhfq0vbdd6m19e0d3q1sx5ixp' />
          </datasources>
          <datasource-dependencies datasource='federated.0eprhfq0vbdd6m19e0d3q1sx5ixp'>
            <column caption='Price Range' datatype='string' name='[Calculation_1569610711736320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [price] &lt; 200000 THEN &quot;Below $200K&quot;&#13;&#10;ELSEIF [price] &lt; 400000 THEN &quot;$200K–$400K&quot;&#13;&#10;ELSEIF [price] &lt; 600000 THEN &quot;$400K–$600K&quot;&#13;&#10;ELSEIF [price] &lt; 800000 THEN &quot;$600K–$800K&quot;&#13;&#10;ELSEIF [price] &lt;= 1000000 THEN &quot;$800K–$1M&quot;&#13;&#10;ELSE &quot;Above $1M&quot;&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Bathrooms' datatype='real' name='[bathrooms]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Bedrooms' datatype='integer' name='[bedrooms]' role='dimension' type='ordinal' />
            <column-instance column='[id]' derivation='Count' name='[cnt:id:qk]' pivot='key' type='quantitative' />
            <column caption='Id' datatype='integer' name='[id]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1569610711736320]' derivation='None' name='[none:Calculation_1569610711736320:nk]' pivot='key' type='nominal' />
            <column-instance column='[bathrooms]' derivation='None' name='[none:bathrooms:ok]' pivot='key' type='ordinal' />
            <column-instance column='[bedrooms]' derivation='None' name='[none:bedrooms:ok]' pivot='key' type='ordinal' />
            <column-instance column='[zipcode]' derivation='None' name='[none:zipcode:ok]' pivot='key' type='ordinal' />
            <column datatype='real' default-format='c&quot;$&quot;#,##0,K' name='[price]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Zipcode' datatype='real' datatype-customized='true' name='[zipcode]' role='dimension' semantic-role='' type='ordinal' />
          </datasource-dependencies>
          <manual-sort column='[federated.0eprhfq0vbdd6m19e0d3q1sx5ixp].[none:Calculation_1569610711736320:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Below $200K&quot;</bucket>
              <bucket>&quot;$200K–$400K&quot;</bucket>
              <bucket>&quot;$400K–$600K&quot;</bucket>
              <bucket>&quot;$600K–$800K&quot;</bucket>
              <bucket>&quot;$800K–$1M&quot;</bucket>
              <bucket>&quot;Above $1M&quot;</bucket>
